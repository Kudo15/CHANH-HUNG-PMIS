# Synthetic local development placeholders only. Copy to .env and replace CHANGE_ME.
POSTGRES_DB=pmis_dev
POSTGRES_USER=pmis_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Compose uses db; native backend uses 127.0.0.1 instead. URL-encode password characters.
DATABASE_URL=postgresql+psycopg://pmis_dev:CHANGE_ME_LOCAL_ONLY@db:5432/pmis_dev

# OIDC provider configuration (provider-neutral synthetic placeholders; no real secrets)
# When running with opt-in 'local-oidc' Keycloak profile, use:
# OIDC_ISSUER=http://127.0.0.1:8081/realms/chpmis-dev
# OIDC_CLIENT_ID=pmis-local
# OIDC_CLIENT_SECRET=CHANGE_ME_LOCAL_OIDC_SECRET
# OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:8081/realms/chpmis-dev/protocol/openid-connect/auth
# OIDC_TOKEN_ENDPOINT=http://127.0.0.1:8081/realms/chpmis-dev/protocol/openid-connect/token
# OIDC_JWKS_URI=http://127.0.0.1:8081/realms/chpmis-dev/protocol/openid-connect/certs
# (Inside Docker Compose backend network, token and jwks use http://keycloak:8080/realms/chpmis-dev/...)
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=pmis_local
OIDC_CLIENT_SECRET=CHANGE_ME_LOCAL_OIDC_SECRET
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/oauth/authorize
OIDC_TOKEN_ENDPOINT=https://idp.example.com/oauth/token
OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# Synthetic local Keycloak bootstrap admin credentials (process-local, opt-in profile: local-oidc)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LOCAL_KC_ADMIN_PASSWORD
KC_SYNTHETIC_ADMIN1_PASSWORD=CHANGE_ME_LOCAL_ADMIN1_PASSWORD
KC_SYNTHETIC_ADMIN2_PASSWORD=CHANGE_ME_LOCAL_ADMIN2_PASSWORD
